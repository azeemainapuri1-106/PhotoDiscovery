# Copy this file to ".env" and adjust. Vite only exposes variables starting with VITE_

# true  -> use the local mock data in src/data (no backend needed)
# false -> call the real backend through src/services
VITE_USE_MOCK=true

# Base URL every API request is built from.
# "/api" works with the dev proxy in vite.config.js (no CORS issues in dev).
# In production you can use a full URL, e.g. https://api.yoursite.com/api
VITE_API_BASE_URL=/api

# Where the Vite dev server forwards "/api" calls (your Spring Boot app)
VITE_DEV_PROXY_TARGET=http://localhost:8080
